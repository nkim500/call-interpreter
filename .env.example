# LiveKit Cloud — get from https://cloud.livekit.io project settings
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Your provisioned LiveKit phone number, E.164 format, e.g. +12025550100
# Used by scripts/setup-sip.sh to render livekit/inbound-trunk.json
LIVEKIT_PHONE_NUMBER=

# OpenAI — bring your own key (don't burn LiveKit's $2.50 inference credits)
OPENAI_API_KEY=

# v2 pipelined mode (set INTERPRETER_MODE=pipelined to activate)
INTERPRETER_MODE=realtime
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
ELEVEN_API_KEY=

# Optional: when set, transcript logger writes JSONL to {LOG_DIR}/turns-{date}.jsonl
# Typically set only in local dev. On the deployed agent, stdout-only is the design.
LOG_DIR=
